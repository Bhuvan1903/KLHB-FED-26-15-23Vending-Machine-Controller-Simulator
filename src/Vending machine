import java.io.IOException;
import java.nio.file.*;
import java.util.*;
import java.util.stream.*;

class Product {
    int id, stock;
    String name;
    double price;

    Product(int id, String name, double price, int stock) {
        this.id = id;
        this.name = name;
        this.price = price;
        this.stock = stock;
    }

    public String toString() {
        return id + ". " + name + " - Rs." + price
                + " | Stock: " + stock;
    }
}

