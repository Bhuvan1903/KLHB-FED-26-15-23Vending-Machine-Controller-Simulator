import java.io.IOException;
import java.nio.file.*;
import java.util.*;
import java.util.stream.*;

class Product {
    int id, stock;
    String name;
    double price;

    Product(int id, String name, double price, int stock) {
        this.id = id;
        this.name = name;
        this.price = price;
        this.stock = stock;
    }

    
    public String toString() {
        return id + ". " + name + " - Rs." + price
                + " | Stock: " + stock;
    }
}

public class VendingMachineSimulator1 {

    Scanner sc = new Scanner(System.in);

    Product[] products = {
        new Product(1, "Water", 20, 10),
        new Product(2, "Juice", 35, 8),
        new Product(3, "Chips", 20, 12),
        new Product(4, "Chocolate", 30, 10),
        new Product(5, "Biscuits", 15, 15)
    };

    ArrayList<String> history = new ArrayList<>();
    Path file = Path.of("transactions.txt");

    int readInt(String msg) {
        while (true) {
            try {
                System.out.print(msg);
                return Integer.parseInt(sc.nextLine().trim());
            } catch (NumberFormatException e) {
                System.out.println("Enter a valid whole number.");
            }
        }
    }

    void showProducts() {
        for (Product p : products) {
            System.out.println(p);
        }
    }

    void buyProduct() {
        showProducts();

        int id = readInt("Enter product ID (0 to cancel): ");

        if (id == 0) {
            return;
        }

        Product selected = null;

        for (Product p : products) {
            if (p.id == id) {
                selected = p;
                break;
            }
        }

        if (selected == null || selected.stock <= 0) {
            System.out.println("Invalid product or out of stock.");
            return;
        }

        int qty = readInt("Enter quantity: ");

        if (qty <= 0 || qty > selected.stock) {
            System.out.println("Invalid quantity.");
            return;
        }

        double total = selected.price * qty;
        System.out.println("Total: Rs." + total);

        double paid = 0;

        while (paid < total) {
            System.out.print("Insert cash (0 to cancel): ");

            double amount;

            try {
                amount = Double.parseDouble(sc.nextLine().trim());
            } catch (NumberFormatException e) {
                System.out.println("Invalid amount.");
                continue;
            }

            if (!Double.isFinite(amount) || amount < 0) {
                System.out.println("Enter a valid amount.");
                continue;
            }

            if (amount == 0) {
                System.out.println("Purchase cancelled.");
                return;
            }

            paid += amount;
        }

        double change =
                Math.round((paid - total) * 100.0) / 100.0;

        selected.stock -= qty;

        String receipt = selected.name + " x" + qty
                + " | Total: Rs." + total
                + " | Paid: Rs." + paid
                + " | Change: Rs." + change;

        history.add(receipt);

        System.out.println("Payment successful!");
        System.out.println(receipt);
        System.out.println("Item dispensed!");

        try {
            Files.writeString(
                    file,
                    receipt + System.lineSeparator(),
                    StandardOpenOption.CREATE,
                    StandardOpenOption.APPEND
            );
        } catch (IOException e) {
            System.out.println("Could not save transaction.");
        }
    }
void salesReport() {
        System.out.println(
                "Transactions this session: " + history.size());

        if (history.isEmpty()) {
            System.out.println("No transactions in this session.");
        } else {
            history.forEach(System.out::println);
        }

        try (Stream<String> lines = Files.lines(file)) {
            System.out.println(
                    "Saved transaction count: " + lines.count());
        } catch (IOException e) {
            System.out.println("No saved transactions yet.");
        }
    }

    void sortByPrice() {
        Arrays.sort(
                products,
                Comparator.comparingDouble(p -> p.price)
        );

        System.out.println("\nProducts sorted by price:");
        showProducts();
    }

    
    void run() {
        int choice;

        do {
            System.out.println("\n=== CASH VENDING MACHINE ===");
            System.out.println("1. View products");
            System.out.println("2. Buy product");
            System.out.println("3. Sort by price");
            System.out.println("4. Transaction history");
            System.out.println("5. Exit");

 choice = readInt("Enter choice: ");

            switch (choice) {
                case 1:
                    showProducts();
                    break;

                case 2:
                    buyProduct();
                    break;

                case 3:
                    sortByPrice();
                    break;

                case 4:
                    salesReport();
                    break;

                case 5:
                    System.out.println("Thank you!");
                    break;

                default:
                    System.out.println("Invalid choice.");
            }
 } while (choice != 5);
    }

    public static void main(String[] args) {
        VendingMachineSimulator1 vm =
                new VendingMachineSimulator1();

        vm.run();
    }
}
